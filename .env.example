# =============================================================
# CrimeNet Intelligence Platform - Environment Configuration
# Copy this file to .env and fill in real values
# NEVER commit .env to source control
# =============================================================

# --- PostgreSQL ---
POSTGRES_USER=crimenet
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=crimenet_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# DATABASE_URL is constructed from the above in code
# or override explicitly:
# DATABASE_URL=postgresql+asyncpg://crimenet:password@postgres:5432/crimenet_db

# --- Neo4j ---
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change_me_neo4j_password

# --- Authentication ---
# Generate with: openssl rand -hex 32
SECRET_KEY=change_me_generate_a_real_secret_key
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- AI / LLM Provider ---
# Supported: openai | anthropic | gemini | mock
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=AIza...

# LLM model name (provider-specific)
LLM_MODEL=gpt-4o-mini

# --- File Storage ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50

# --- CORS ---
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- External APIs (optional enrichment) ---
# Google Maps / Geocoding
GOOGLE_MAPS_API_KEY=

# OpenStreetMap / Nominatim (free, no key required)
NOMINATIM_USER_AGENT=crimenet-prototype

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
